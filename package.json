{
  "name": "linkle-hp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "start": "next dev -p 3000",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "npx serve out -l 3010",
    "check": "node scripts/check-export.mjs",
    "seo:report": "node scripts/seo-report.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "deploy": "npm run build && npm run check && aws s3 sync out/ s3://linkle-hp --delete && aws cloudfront create-invalidation --distribution-id E1P3P8CPSEO8HE --paths \"/*\" && npm run indexnow"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "animejs": "3.2.2",
    "next": "^15.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0"
  }
}
